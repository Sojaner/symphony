{
  "description": "Symphony lifecycle observation and completion guard for Codex.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/symphony_hook.py\"", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/symphony_hook.py\"", "timeout": 10, "additionalContextLimit": 4096}]}],
    "PreToolUse": [{"matcher": "Agent|spawn_agent", "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/symphony_hook.py\"", "timeout": 10}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/symphony_hook.py\"", "timeout": 10, "additionalContextLimit": 2048}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/symphony_hook.py\"", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/symphony_hook.py\"", "timeout": 30, "statusMessage": "Symphony is reconciling active work"}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/symphony_hook.py\"", "timeout": 3}]}]
  }
}
